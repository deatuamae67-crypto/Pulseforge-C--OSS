# PulseForge built-in content is part of the engine source tree. Large/binary
# assets are versioned through Git LFS so `mods/` and `assets/menu/` contain the
# real engine content without hitting GitHub's ordinary-blob size limits.
# Keep textual documentation/configuration inside those trees as ordinary Git.
assets/menu/*.mp3 filter=lfs diff=lfs merge=lfs -text
assets/menu/*.ogg filter=lfs diff=lfs merge=lfs -text
assets/menu/*.wav filter=lfs diff=lfs merge=lfs -text
assets/menu/*.flac filter=lfs diff=lfs merge=lfs -text
